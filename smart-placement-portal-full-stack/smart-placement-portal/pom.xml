<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =========================================================
         PARENT: Spring Boot provides default versions for all
         dependencies so we don't have to specify them manually.
    ========================================================= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <!-- =========================================================
         PROJECT IDENTITY
    ========================================================= -->
    <groupId>com.smartplacement</groupId>
    <artifactId>smart-placement-portal</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Smart Placement Portal</name>
    <description>College Placement Management System</description>

    <!-- =========================================================
         JAVA VERSION
    ========================================================= -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- =========================================================
         DEPENDENCIES: Libraries our project needs to run.
    ========================================================= -->
    <dependencies>

        <!-- Spring Boot Web: Gives us Spring MVC + embedded Tomcat server
             so we can create REST APIs without any external server setup -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA: Lets us talk to MySQL using Java objects
             instead of writing raw SQL. JPA = Java Persistence API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- MySQL Driver: Allows Java to connect to MySQL database -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Validation: Lets us validate user input easily
             using annotations like @NotBlank, @Email, @Min etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok: Reduces boilerplate code. Automatically generates
             getters, setters, constructors using annotations like
             @Data, @Getter, @Setter, @NoArgsConstructor -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot DevTools: Automatically restarts the app when
             you make changes. Very useful during development. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- BCrypt: secure password hashing without enabling the full Spring Security stack -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Spring Boot Test: Provides testing utilities -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =========================================================
         BUILD: Maven plugin to package the project as a runnable JAR
    ========================================================= -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
